# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/hiveconcerts"

# ── Auth.js ──
AUTH_SECRET=""                # required, even locally: openssl rand -base64 32 (or: npx auth secret)
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""             # optional: Google sign-in appears once both Google values are set
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ──
RESEND_API_KEY=""             # optional locally: without it, sign-in links print in the terminal
EMAIL_FROM="HiveConcerts <hello@hiveconcerts.com>"

# ── Media (Cloudflare R2) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hiveconcerts-media"
R2_PUBLIC_BASE_URL=""         # e.g. https://media.hiveconcerts.com

# ── FX (display-only conversion) ──
FX_RATES_API_URL="https://open.er-api.com/v6/latest/USD"   # free, no key; must return USD-based rates

# ── Testing ──
AUTH_TEST_MODE=""             # "1" only for Playwright: exposes /api/test/magic-link (never in production)

# ── Cron ──
CRON_SECRET=""                # openssl rand -hex 32; Vercel Cron sends it as a Bearer token

# ── Rate limiting (Upstash) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Observability ──
SENTRY_DSN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="hiveconcerts.com"

# ── App ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
