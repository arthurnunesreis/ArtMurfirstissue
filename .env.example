# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/hiveconcerts"

# ── Auth.js ──
AUTH_SECRET=""                # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="HiveConcerts <hello@hiveconcerts.com>"

# ── Media (Cloudflare R2) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hiveconcerts-media"
R2_PUBLIC_BASE_URL=""         # e.g. https://media.hiveconcerts.com

# ── FX (display-only conversion) ──
FX_RATES_API_URL=""

# ── Cron ──
CRON_SECRET=""

# ── Rate limiting (Upstash) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Observability ──
SENTRY_DSN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="hiveconcerts.com"

# ── App ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
